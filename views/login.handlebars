<main class="conteudo-principal">

<form method="post" action="/cadastro/">


        <div class="login">

            <div class="login-container">

                <div class="foto">
                    <img src="/img/Kleber/Kleber_studio.jpg"
                        class="img-login"
                        alt="Foto">
                </div>

                <div class="dados">

                    <h1>Seja Bem-Vindo!</h1>

                        {{#if erro}}
                            <p class="form-erro">{{erro}}</p>
                        {{else if next}}
                            <p class="form-aviso">Faça login para acessar esta página.</p>
                        {{/if}}


                    <input type="email" name="email" placeholder="Seu e-mail" value="{{valores.email}}" maxlength="100" autocomplete="email" required>
                    <input type="password" name="confirmar" placeholder="Informe a senha" minlength="6" autocomplete="new-password" required>


                    <p class="esqueci">Esqueci Minha Senha</p>

                <button type="submit" class="button-agendamento">Cadastrar</button>
                

            <div class="bottom">

            <div class="google-login">
                <img src="../public/icon/google.png" class="google" alt="">
                <span>Google</span>
            </div>

            <p class="criar">
                Não tem uma Conta? <a href=""><strong>Crie uma!</strong></a>
            </p>

        </div>
                </div>

            </div>

        </div>

    </form>
</main>