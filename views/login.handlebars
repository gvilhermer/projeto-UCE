<main class="auth-page">

<div class="login">

    <div class="login-container">

        <div class="foto">
            <img src="/img/Kleber/Kleber_studio.jpg"
                 class="img-login"
                 alt="Foto">
        </div>

        <div class="dados">

            <h1>Bem-vindo(a)!</h1>

            {{#if erro}}
            <p style="color: red;">{{erro}}</p>
            {{/if}}

            {{#if logado}}
            <p style="color:#CFAB1C; font-size: large; text-align: center;">
            Você já esta Logado
            </p>
            {{/if}}

    <form action="/login/entrar/" method="POST">
            <label for="usuario">Usuário</label>
            <input type="text"
                   id="usuario"
                   name="usuario"
                   placeholder="Digite seu email"
                   required>

            <label for="senha">Senha</label>
            <input type="password" 
                   id="senha"
                   name="senha"
                   placeholder="Digite sua senha"
                   required >

            <p class="esqueci">Esqueci Minha Senha</p>

        

        <button type="submit" id="btnLogin" class="auth-button">Entrar</button>

        </form>
           

    <div class="bottom">


    <p class="criar">
        Não tem uma Conta? <a href="/cadastro"><strong>Crie uma!</strong></a>
    </p>

</div>
        </div>

    </div>

</div>


</main>
